{
  "name": "cortico-world-asr",
  "version": "0.2.0",
  "type": "module",
  "description": "Cortico World: microphone speech recognition — RtAudio capture, energy-gated segmentation, FireRedASR2-AED backend, subtitle overlay",
  "author": "Phantivia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phantivia/cortico-world-asr.git"
  },
  "homepage": "https://github.com/Phantivia/cortico-world-asr#readme",
  "bugs": {
    "url": "https://github.com/Phantivia/cortico-world-asr/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "asr",
    "speech-recognition",
    "fireredasr"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "audify": "^1.10.1",
    "opencc-js": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
